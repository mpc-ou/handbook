  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true }); console.log('Cleaned .next cache successfully.');\"",
    "// Database Management": "--- PostgreSQL Database Management via Prisma ---",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "// Data Seed & Clean Commands": "--- Commands to populate or clear seed / test progression data ---",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean": "tsx prisma/clean.ts",
    "db:clean:progress": "tsx prisma/clean.ts --only-progress",
    "db:reset": "tsx prisma/clean.ts && tsx prisma/seed.ts"
  },
