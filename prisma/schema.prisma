// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN   // Ban Chủ Nhiệm: Toàn quyền hệ thống
  EDITOR  // Trưởng/Phó ban, Leader sự kiện: Quyền tạo/sửa nội dung trong khóa học được giao
  MEMBER  // Thành viên / CTV: Chỉ đọc và làm bài tập
}

enum ContentStatus {
  DRAFT          // Bản nháp của tác giả
  PENDING_REVIEW // Chờ duyệt
  PUBLISHED      // Đã xuất bản (khóa sửa, cần rollback về PENDING_REVIEW để sửa)
}

enum ItemType {
  CONTENT    // Chương: nội dung (block editor)
  QUIZ       // Bài tập / kiểm tra trắc nghiệm (bắt buộc có Quiz)
  ASSIGNMENT // Bài tập nộp bài / tự luận (bắt buộc có Quiz)
}

enum NotificationType {
  COMMENT              // có người bình luận ở chương của bạn (admin nhận tất cả)
  REPLY                // có người trả lời bình luận của bạn
  MENTION              // có người nhắc tên bạn trong bình luận
  COURSE_COMPLETED     // (admin) một học viên hoàn thành khóa học
  CERTIFICATE_READY    // (học viên) bạn đã hoàn thành khóa học
  ASSIGNMENT_SUBMITTED // (staff) có bài tập chờ chấm
  ASSIGNMENT_GRADED    // (học viên) bài tập của bạn đã được chấm
}

enum Visibility {
  PUBLIC
  UNPUBLIC
}

enum Audience {
  FREE
  INTERNAL
}

enum AttemptStatus {
  COMPLETED
  PENDING_REVIEW
  GRADED
}

// ─────────────────────────────────────────────────────────────
// Cấu trúc nội dung:  Course (cover) → Lesson (cover) → Item (KHÔNG cover)
// Course gắn nhiều Category (phẳng) qua CourseCategory.
// Thứ tự học: Course.sequential là mặc định; Lesson/Item.requirePrevious ghi đè (null = kế thừa).
// ─────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(cuid())
  ssoId           String         @unique
  email           String         @unique
  passwordHash    String?
  noPassword      Boolean        @default(false)
  fullName        String
  avatarUrl       String?
  department      String?
  managedGroups   Json           @default("[]")
  role            Role           @default(MEMBER)
  coursesAuthored Course[]       @relation("CourseAuthor")
  coursesUpdated  Course[]       @relation("CourseUpdater")
  itemsAuthored   Item[]         @relation("ItemAuthor")
  itemsUpdated    Item[]         @relation("ItemUpdater")
  progress        UserProgress[]
  quizAttempts    QuizAttempt[]
  managedCourses  CourseEditor[]
  likes           ItemLike[]
  comments        Comment[]
  uploadedFiles   UploadedFile[]
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ssoId])
  @@index([email])
}

/// Danh mục phẳng (tag) dùng để nhóm Course.
model Category {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  icon        String?          // tên icon lucide
  orderIndex  Int              @default(0)
  courses     CourseCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orderIndex])
}

model Course {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  summary       String?
  coverImage    String?          // URL Cloudinary | "preset:<id>"
  status        ContentStatus    @default(DRAFT)
  orderIndex    Int              @default(0)
  sequential    Boolean          @default(true) // true = học theo thứ tự
  visibility    Visibility       @default(PUBLIC)
  audience      Audience         @default(INTERNAL)
  allowedGroups Json             @default("[]")
  authorId      String
  author        User             @relation("CourseAuthor", fields: [authorId], references: [id])
  updaterId     String?
  updater       User?            @relation("CourseUpdater", fields: [updaterId], references: [id])
  categories    CourseCategory[]
  lessons       Lesson[]
  editors       CourseEditor[]
  uploadedFiles UploadedFile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, orderIndex])
}

model CourseCategory {
  id         String   @id @default(cuid())
  courseId   String
  categoryId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([courseId, categoryId])
  @@index([categoryId])
}

/// EDITOR được phép sửa nội dung của Course nào.
model CourseEditor {
  id       String @id @default(cuid())
  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Lesson {
  id              String         @id @default(cuid())
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  summary         String?
  coverImage      String?
  orderIndex      Int            @default(0)
  isPublished     Boolean        @default(false)
  requirePrevious Boolean?       // null = theo Course.sequential
  items           Item[]
  uploadedFiles   UploadedFile[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, orderIndex])
}

/// Chương hoặc bài tập. KHÔNG có ảnh bìa.
model Item {
  id                    String         @id @default(cuid())
  lessonId              String
  lesson                Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type                  ItemType       @default(CONTENT)
  title                 String
  slug                  String
  summary               String?
  orderIndex            Int            @default(0)
  status                ContentStatus  @default(DRAFT)
  isRequired            Boolean        @default(true)
  requirePrevious       Boolean?       // null = kế thừa Lesson/Course
  requireScrollToBottom Boolean        @default(true)
  passScorePercent      Int?
  content               Json           @default("[]")
  plainText             String         @default("") @db.Text
  readingTime           Int            @default(1)
  attachments           Json           @default("[]")
  likesCount            Int            @default(0)
  viewsCount            Int            @default(0)
  authorId              String
  author                User           @relation("ItemAuthor", fields: [authorId], references: [id])
  updaterId             String?
  updater               User?          @relation("ItemUpdater", fields: [updaterId], references: [id])
  quiz                  Quiz?
  progress              UserProgress[]
  likes                 ItemLike[]
  comments              Comment[]
  uploadedFiles         UploadedFile[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([lessonId, slug])
  @@index([lessonId, orderIndex])
  @@index([status])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  itemId    String
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?   // null = Bậc 1 (gốc), có giá trị = Bậc 2 (trả lời)
  parent    Comment?  @relation("CommentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentHierarchy")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([itemId, createdAt])
  @@index([parentId])
}

model ItemLike {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([itemId])
  @@index([userId])
}

model Quiz {
  id               String        @id @default(cuid())
  title            String?
  description      String?
  itemId           String?       @unique
  item             Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  durationMinutes  Int?
  passScorePercent Int           @default(80)
  maxAttempts      Int?
  isExam           Boolean       @default(false)
  questions        Json          @default("[]")
  attempts         QuizAttempt[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

/// Tiến độ lưu theo Item. Tiến độ Lesson/Course được tính suy ra, không lưu.
model UserProgress {
  id                String    @id @default(cuid())
  userId            String
  itemId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  hasScrolledBottom Boolean   @default(false)
  highestQuizScore  Int?
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  lastAccessedAt    DateTime  @default(now())

  @@unique([userId, itemId])
  @@index([userId, isCompleted])
}

model QuizAttempt {
  id           String        @id @default(cuid())
  userId       String
  quizId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  scorePercent Int
  answers      Json
  isPassed     Boolean
  timeSpentSec Int?
  status       AttemptStatus @default(COMPLETED)
  feedback     String?
  gradedBy     String?
  gradedAt     DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId, quizId])
  @@index([quizId, createdAt])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  @default("#f97316")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model UploadedFile {
  id         String   @id @default(cuid())
  publicId   String   @unique
  url        String
  bytes      Int?
  format     String?
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  isAttached Boolean  @default(false) // True when saved into a course/lesson/item
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([publicId])
  @@index([isAttached, createdAt])
  @@index([uploaderId])
}

/// Thông báo trong ứng dụng. Nội dung dịch ở client theo `type` + `data` (snapshot tên/đường dẫn lúc tạo).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}
